# CallEnvoy service env (names only; real values live in .env on the server, chmod 600)
# Optional, old single key: imported once as the first agent key when the key list is empty, then not needed.
# New keys are made in the console (Agents).
CALLENVOY_API_KEY=
# The admin's address (sees usage of all users, can disable / remove users, switches sign-ups on or off).
# Required to upgrade a database from before user accounts: its data is given to this user.
OWNER_EMAIL=
# Console sign-in by a one-time email link, for any address (without them: uv run python -m callenvoy.signin [email])
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# The public address (https). It may include a path (https://example.com/callenvoy) when the service shares a host.
# Used for webhook / wss URLs, Twilio signature checks, the session cookie path and the allowed Origin.
PUBLIC_BASE_URL=https://callenvoy.pragnyalabs.com
# The server's own provider accounts: the admin's calls, and everyone's free calls to the demo line.
# Every other user saves their own Twilio and OpenAI keys in the console (Settings > Provider keys).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The CallEnvoy outbound number (E.164)
TWILIO_FROM_NUMBER=+19186021019
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
FISH_API_KEY=
# Optional: another OpenAI-compatible AI service for the admin's calls (pick "custom" as the AI model in Settings).
# LLM_ANY_HOST=1 lets users of this server save any address too, not only the well-known services (config.LLM_SERVICES).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_ANY_HOST=1
# Encrypts the provider keys that users save (Fernet). Make it once: uv run python -m callenvoy.keys --make-key
# Keep it: without the same value the saved keys cannot be read. Without it users cannot save keys at all.
CALLENVOY_SECRET_KEY=
# Web push (optional; make with: uv run python -m callenvoy.push --make-keys). Without them push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Debugging only: PIPECAT_LOG_LEVEL=DEBUG turns on Pipecat's own log, which then holds what is said on calls.
# Local development only: skips the client/dist check and allows the Expo web dev origin
# CALLENVOY_DEV=1
