# systemd unit for CallEnvoy: /etc/systemd/system/callenvoy.service
# One worker only: live call state is in memory. Change User and the paths to your own.
[Unit]
Description=CallEnvoy
After=network-online.target
Wants=network-online.target

[Service]
User=agent
WorkingDirectory=/home/agent/apps/callenvoy
EnvironmentFile=/home/agent/apps/callenvoy/.env
ExecStart=/home/agent/.local/bin/uv run --frozen --no-dev uvicorn callenvoy.main:app --host 127.0.0.1 --port 3021 --no-access-log
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
